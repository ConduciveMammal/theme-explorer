{
  "name": "theme-explorer",
  "name_formatted": "Theme Explorer for Shopify",
  "name_development": "Dev - Theme Explorer for Shopify",
  "version": "2.0.0",
  "description": "Theme Explorer allows you to view important information about the themes installed on your Shopify store.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ConduciveMammal/theme-explorer"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --mode development",
    "dev:watch": "vite build --mode development --watch",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:firefox": "TARGET_BROWSER=firefox vite build --mode production",
    "build:firefox:dev": "TARGET_BROWSER=firefox vite build --mode development",
    "package:bundle:chrome": "node scripts/package-bundles.js chrome",
    "package:bundle:firefox": "node scripts/package-bundles.js firefox",
    "package:bundle": "node scripts/package-bundles.js",
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "qa:verify-build": "node scripts/qa/verify-build.js",
    "qa:release-candidate": "npm run build:prod && npm run qa:verify-build"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.0.16",
    "@kunukn/react-collapse": "^2.2.9",
    "fuse.js": "^7.0.0",
    "html-react-parser": "^3.0.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-toastify": "^9.0.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@types/chrome": "^0.0.177",
    "@types/react": "^17.0.39",
    "@types/react-dom": "^17.0.11",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.8.0",
    "eslint-config-react-app": "^7.0.0",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "prettier": "^2.5.1",
    "sass": "^1.54.5",
    "stylelint": "^14.9.1",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "stylelint-config-standard-scss": "^5.0.0",
    "stylelint-prettier": "^2.0.0",
    "stylelint-selector-bem-pattern": "^2.1.1",
    "typescript": "^4.5.5",
    "vite": "^7.3.1"
  }
}
